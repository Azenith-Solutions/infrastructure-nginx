# IP da máquina na rede local — usado pelo Expo para que o celular acesse a API
# Descobrir: ip route get 1 | awk '{print $7; exit}'   (Linux)
#            ipconfig getifaddr en0                      (macOS)
HOST_IP=192.168.x.x

# Token do Expo (expo.dev → Account Settings → Access Tokens)
# Necessário para o tunnel funcionar sem login interativo
EXPO_TOKEN=
